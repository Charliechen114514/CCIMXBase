*.o
*.obj
*.lo
*.la
*.al
*.libs
*.so
*.so.*
*.a
*.lib
*.dll
*.exe
*.app
*.dylib

# moc、rcc、ui 自动生成的中间文件
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp

# CMake 中间文件和输出目录
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
CTestTestfile.cmake
Testing/
compile_commands.json

# Ninja
.ninja_deps
.ninja_log
build.ninja
rules.ninja

# QML 缓存（如果你使用了 QML 引擎）
.qmlcache/
*.qmlc
*.jsc

